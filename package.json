{
  "name": "magic-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "cors": "^2.8.5",
    "firebase": "^11.1.0",
    "jest-localstorage-mock": "^2.4.26",
    "json-server": "^0.17.4",
    "lowdb": "^5.1.0",
    "nodemon": "^3.1.9",
    "react": "^18.3.1",
    "react-awesome-reveal": "^4.2.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-intersection-observer": "^9.13.1",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^6.28.0",
    "react-scripts": "5.0.1",
    "react-test-renderer": "^18.3.1",
    "scryfall-client": "^0.23.0",
    "swr": "^2.2.5",
    "typescript": "^4.9.5",
    "web-vitals": "^4.2.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "CI=false GENERATE_SOURCEMAP=false react-scripts build",
    "build-css": "nodemon -e scss -x \"sass --watch src/sass/index.scss:src/styles/index.css\"",
    "test": "react-scripts test test --coverage --watchAll --runInBand",
    "eject": "react-scripts eject",
    "test:all": "react-scripts test --watchAll --collect-coverage",
    "test:prod": "react-scripts test --watchAll --collect-coverage --watchAll=false",
    "lint": "eslint .",
    "start:dev": "concurrently --kill-others-on-fail \"npm run server\" \"npm run client\"",
    "json-server": "node server.js",
    "server": "json-server --watch db.json --port 3000"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:@typescript-eslint/recommended",
      "prettier"
    ],
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "plugins": [
      "@typescript-eslint"
    ],
    "rules": {
      "testing-library/no-render-in-setup": "off",
      "@typescript-eslint/no-explicit-any": "warn",
      "react-hooks/exhaustive-deps": "warn",
      "array-callback-return": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "prettier": {
    "singleQuote": true
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "<rootDir>/src/reportWebVitals.ts",
      "<rootDir>/src/index.ts",
      "<rootDir>/src/tools/*"
    ]
  },
  "devDependencies": {
    "@types/react-test-renderer": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint-config-prettier": "^9.1.0",
    "jest-fetch-mock": "^3.0.3",
    "sass": "^1.83.0"
  }
}
